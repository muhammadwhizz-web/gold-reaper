# ──────────────────────────────────────────────────────────────
#  GOLD REAPER :: configuration
#  copy this file to .env and fill in your secrets
#  NEVER commit .env — it is gitignored for a reason
# ──────────────────────────────────────────────────────────────

# ── BROKER ────────────────────────────────────────────────────
# MT5    = Exness via MetaTrader 5 terminal (Windows / Wine)
# BITGET = Bitget futures via ccxt (native, any OS)
# PAPER  = simulation, no money at risk (default)
BROKER=PAPER
PAPER_MODE=true

# ── EXNESS / METATRADER 5 ─────────────────────────────────────
MT5_LOGIN=12345678
MT5_PASSWORD=your_mt5_password
MT5_SERVER=Exness-MT5Real8
# optional custom terminal path (windows):
# MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
MT5_SYMBOL=XAUUSD

# ── BITGET (futures, tokenized gold: XAUT or PAXG) ────────────
BITGET_KEY=
BITGET_SECRET=
BITGET_PASSPHRASE=
BITGET_SYMBOL=XAUT/USDT:USDT
BITGET_LEVERAGE=3

# ── CAPITAL & RISK ────────────────────────────────────────────
STARTING_BALANCE=1000
RISK_PER_TRADE_PCT=1.0
MAX_DAILY_LOSS_PCT=3.0
MAX_CONSEC_LOSSES=3
MAX_OPEN_TRADES=1
MAX_TRADES_PER_SESSION=4

# ── MISSION TARGETS (the hunt) ────────────────────────────────
TARGET_PER_SESSION_USD=20
TARGET_PER_DAY_USD=120
STOP_AFTER_TARGET=true

# ── STRATEGY (locked by 4-fold walk-forward) ──────────────────
MIN_ADX=24
SL_ATR_MULT=1.2
TP_ATR_MULT=3.2
BREAKEVEN_AT_R=1.0
TRAIL_START_R=1.5
MIN_ATR_PRICE=3.0
TRADE_LONDON=false
TRADE_OVERLAP=true
TRADE_ASIA=false
TRADE_NEWYORK=false

# ── RUNTIME ───────────────────────────────────────────────────
POLL_SECONDS=60
HEARTBEAT_MINUTES=30

# ──────────────────────────────────────────────────────────────
#  GOLD REAPER APEX :: configuration
#  copy to .env and fill in. NEVER commit .env
# ──────────────────────────────────────────────────────────────

# ── BROKER ────────────────────────────────────────────────────
BROKER=PAPER
PAPER_MODE=true

# ── EXNESS / METATRADER 5 ─────────────────────────────────────
MT5_LOGIN=12345678
MT5_PASSWORD=your_mt5_password
MT5_SERVER=Exness-MT5Real8
MT5_SYMBOL=XAUUSD

# ── BITGET (tokenized gold futures XAUT/USDT) ─────────────────
BITGET_KEY=
BITGET_SECRET=
BITGET_PASSPHRASE=
BITGET_SYMBOL=XAUT/USDT:USDT
BITGET_LEVERAGE=3

# ── MULTI-ACCOUNT (optional; overrides BROKER if set) ─────────
# format: KIND|p1|p2|p3|label ; separated by ';'
# APEX_ACCOUNTS=MT5|111|pass|Exness-MT5Real8|acc1;BITGET|key|sec|ph|acc2

# ── CAPITAL & RISK ────────────────────────────────────────────
STARTING_BALANCE=1000
RISK_PER_TRADE_PCT=1.0
MAX_DAILY_LOSS_PCT=3.0
MAX_CONSEC_LOSSES=3
MAX_OPEN_TRADES=1
MAX_TRADES_PER_SESSION=4

# ── MISSION TARGETS ───────────────────────────────────────────
TARGET_PER_SESSION_USD=20
TARGET_PER_DAY_USD=120
STOP_AFTER_TARGET=true

# ── STRATEGY (locked by 4-fold walk-forward) ──────────────────
MIN_ADX=24
SL_ATR_MULT=1.2
TP_ATR_MULT=3.2
BREAKEVEN_AT_R=1.0
TRAIL_START_R=1.5
MIN_ATR_PRICE=3.0
TRADE_LONDON=false
TRADE_OVERLAP=true
TRADE_ASIA=false
TRADE_NEWYORK=false

# ── RUNTIME ───────────────────────────────────────────────────
POLL_SECONDS=60
HEARTBEAT_MINUTES=30
# broker failover order (default MT5,BITGET,PAPER)
FAILOVER_CHAIN=
# bitget market type: swap | spot
BITGET_MARKET=swap
# dashboard port (launchers open this URL)
DASHBOARD_PORT=8080
# watchdog: heartbeat staleness window + check interval (seconds)
WATCHDOG_STALE_SECONDS=180
WATCHDOG_INTERVAL=60
# in-process crash supervisor (bot rebuilds itself after fatal errors)
SUPERVISOR=1

# ── APEX OPS ──────────────────────────────────────────────────
# optional Redis mirror of risk/audit state (disk is always source of truth)
REDIS_URL=
# optional LLM sentiment endpoint (POST {headlines:[..]} -> {score, confidence})
APEX_LLM_URL=

# ── ALERTS (all optional) ─────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
